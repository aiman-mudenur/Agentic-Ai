SECRET_KEY=local-dev-course-organizer-change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ENABLE_GOOGLE_CLASSROOM=false
ENABLE_GITHUB=false
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_DEFAULT_BRANCH=main
GOOGLE_CLASSROOM_CRED_PATH=credentials.json
GOOGLE_CLASSROOM_TOKEN_PATH=token.json
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
AUTO_SWARM_ON_SUBMIT=true
AUTO_GRADE_ON_SUBMIT=true
EMAIL_DOMAIN=@gmail.com
ALLOW_SELF_SIGNUP=false

# ── Optional OpenClaw AI Course Assistant ────────────────────────────────────
# OpenClaw is an external Gateway (WebSocket + JSON RPC). Disabled by default so the
# existing app is unaffected. See docs/openclaw_integration.md for full setup.
OPENCLAW_ENABLED=true
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Shared-secret auth also needs a per-installation device identity. The Ed25519
# keypair is generated on first connect and stored at this path (keep it secret):
OPENCLAW_DEVICE_IDENTITY_PATH=
OPENCLAW_ROLE=operator
OPENCLAW_SCOPES=operator.read,operator.write
# Must be one of the Gateway's client ids/modes (defaults work):
OPENCLAW_CLIENT_ID=cli
OPENCLAW_CLIENT_MODE=cli
OPENCLAW_CLIENT_VERSION=1.0.0
OPENCLAW_PLATFORM=windows
OPENCLAW_MIN_PROTOCOL=4
OPENCLAW_MAX_PROTOCOL=4
OPENCLAW_CONNECT_TIMEOUT_MS=10000
OPENCLAW_REQUEST_TIMEOUT_MS=30000
# chat.send is asynchronous; this is the reply-wait budget.
OPENCLAW_CHAT_TIMEOUT_MS=300000
# Optional: pin a Gateway agent id and/or session key (default: agent:main:main).
OPENCLAW_AGENT_ID=
OPENCLAW_SESSION_KEY=
# Optional: system prompt served to the Gateway bridge by GET /openclaw/tools
OPENCLAW_ASSISTANT_PROMPT=
# Restricted backend tools the assistant may use (allowlist)
OPENCLAW_ALLOWED_TOOLS=list_assignments,get_submission_status,find_late_submissions,read_github_activity,summarize_course_notes
